# Google Analytics 4 (GA4) Measurement ID
# Dapatkan ID dari Google Analytics console (Format: G-XXXXXXXXXX)
# Pada Vercel: Tambahkan di Project Settings -> Environment Variables
VITE_GA_MEASUREMENT_ID=

# Meta Pixel (Facebook & Instagram) ID
# Dapatkan ID dari Meta Events Manager (Format: 15-16 digit angka)
# Pada Vercel: Tambahkan di Project Settings -> Environment Variables
VITE_META_PIXEL_ID=1756144429011846
